{
  "expo": {
    "name": "Pigreen",
    "slug": "pigreen",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pigreen",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF9F0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ericdonato.pigreen"
    },
    "android": {
      "package": "com.ericdonato.pigreen",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF9F0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
