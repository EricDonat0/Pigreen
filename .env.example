# Configuração do Firebase (console.firebase.google.com > Configurações do projeto > Seus apps > Web).
#
# Copie este arquivo para `.env` e preencha com as chaves do seu projeto.
# Depois de mexer no `.env`, reinicie o bundler com cache limpo: `npx expo start -c`.
#
# O prefixo EXPO_PUBLIC_ é obrigatório: sem ele o Metro não injeta a variável no
# bundle. Esses valores viajam no app instalado e NÃO são segredos — quem
# protege os dados são as Security Rules em `firestore.rules`.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
